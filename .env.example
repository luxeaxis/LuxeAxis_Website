# LuxeAxis Web Application — Environment Configuration
# Copy this file to .env.local for local development.

# Lead Webhook Destination (Required in Production)
# Endpoint accepting POST request with JSON lead payload from /api/lead
LEAD_WEBHOOK_URL="https://api.luxeaxis.com/v1/leads/webhook"

# Canonical Site Origin (Used for Open Graph, Canonical URLs, and Sitemap)
NEXT_PUBLIC_SITE_ORIGIN="https://www.luxeaxis.com"

# Analytics & Observability
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Feature Flags (true / false)
NEXT_PUBLIC_FLAG_THREE_V1="false"
NEXT_PUBLIC_FLAG_SMOOTH_SCROLL="true"
