# LuxeAxis Web Application — Environment Configuration
# Copy this file to .env.local for local development.

# Lead Webhook Destination (Required in Production)
# Endpoint accepting POST request with JSON lead payload from /api/lead
LEAD_WEBHOOK_URL="https://api.luxeaxis.com/v1/leads/webhook"

# Canonical Site Origin (Used for Open Graph, Canonical URLs, and Sitemap)
NEXT_PUBLIC_SITE_ORIGIN="https://www.luxeaxis.com"

# Analytics & Observability
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Feature Flags (true / false)
NEXT_PUBLIC_FLAG_THREE_V1="false"
NEXT_PUBLIC_FLAG_SMOOTH_SCROLL="true"

# Google Places API (For dynamic 4.9 rating and client reviews)
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"
GOOGLE_PLACE_ID="your_google_place_id_here"

# WhatsApp Business Direct Chat Numbers (Format: CountryCode + Number e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_SALES_NUMBER="919876543210"
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="919876543211"

# Resend Email Integration (For Careers Applications & Job Inquiries)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CAREERS_RECIPIENT_EMAIL="careers@luxeaxis.in"
RESEND_FROM_EMAIL="Luxe Axis Careers <onboarding@resend.dev>"


